target/
target_classes/
target_test-classes/
*.class
.idea/
*.iml
.vscode/
firebase-service-account.json

# Firebase service account keys. These are private keys: anything matching these patterns
# grants full administrative access to the Firebase project, including minting tokens for
# any user. Never commit one. The app reads the path from FIREBASE_CREDENTIALS instead.
*firebase-adminsdk*.json
*-service-account*.json
serviceAccountKey.json
.env

# Frontend
node_modules/

# The built dashboard. Generated by `npm run build` in frontend/, which writes it here so
# `mvn package` ships one jar. It is build output, not source: committing it means every
# frontend change produces a diff nobody can review and two copies of the truth.
src/main/resources/static/

# Runtime logs from run-local.ps1 and the Vite dev server.
app.log
frontend/dev.log
*.log
