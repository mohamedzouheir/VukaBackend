# Firebase web app config. Identity only: no application data lives in Firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Dev sign in. Leave false unless the backend also runs with VUKA_DEV_AUTH=true.
# It bypasses Firebase entirely and must never be true in a deployed environment.
VITE_DEV_AUTH=false
